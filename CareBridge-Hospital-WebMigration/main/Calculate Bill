def calculate_bill():
    patient_type = input("Enter patient type (Subsidised/Private): ")
    lab_tests = int(input("Enter number of lab tests: "))

    BASE_FEE = 100
    LAB_TEST_RATE = 10

    subtotal = BASE_FEE + (lab_tests * LAB_TEST_RATE)

    if patient_type == "Subsidised":
        total = subtotal * 0.70
    else:
        total = subtotal

    print(f"Total Bill: ${total:.2f}")
